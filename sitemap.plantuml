@startuml sitemap_admin
skinparam shadowing false
skinparam roundcorner 4
skinparam arrow {
    Color #2C3E50
    Thickness 1.5
}

skinparam rectangle {
    BackgroundColor #F1F3F6
    BorderColor #B3B7BD
    FontColor #2C3E50
    FontSize 12
    FontStyle bold
    Padding 10
}

skinparam rectangle<<root>> {
    BackgroundColor #0F2C59
    BorderColor #0A1E3D
    FontColor #FFFFFF
    FontSize 14
    FontStyle bold
    RoundCorner 0
}

rectangle "Admin Panel\n(Manager Portal)" as admin <<root>>

rectangle "1. Dashboard\nThống kê & Báo cáo" as r1
rectangle "2. Staff Management\nQuản lý Nhân sự" as r2
rectangle "3. Product Management\nQuản lý Sản phẩm" as r3
rectangle "4. Supplier Management\nQuản lý Nhà cung cấp" as r4
rectangle "5. Promotion Management\nQuản lý Khuyến mãi" as r5
rectangle "6. Report Approval\nPhê duyệt báo cáo" as r6
rectangle "7. Work Instructions\nGiao việc" as r7

admin --> r1
admin --> r2
admin --> r3
admin --> r4
admin --> r5
admin --> r6
admin --> r7
@enduml

@startuml sitemap_client
skinparam shadowing false
skinparam roundcorner 4
skinparam arrow {
    Color #2C3E50
    Thickness 1.5
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #B3B7BD
    FontColor #2C3E50
    FontSize 11
    Padding 8
}

skinparam rectangle<<root>> {
    BackgroundColor #0F2C59
    BorderColor #0A1E3D
    FontColor #FFFFFF
    FontSize 14
    FontStyle bold
    RoundCorner 0
}

skinparam rectangle<<category>> {
    BackgroundColor #E5E8E8
    BorderColor #BDC3C7
    FontColor #1C2833
    FontSize 12
    FontStyle bold
}

rectangle "Client & Staff Panel\n(Portal Khách hàng & Nhân viên)" as client <<root>>

' Categories
rectangle "1. Auth" as auth <<category>>
rectangle "2. Profile" as profile <<category>>
rectangle "3. Customer Features\n(Khách hàng)" as customer <<category>>
rectangle "4. Cashier Features\n(Thu ngân)" as cashier <<category>>
rectangle "5. Merchandise Features\n(Kho kệ)" as merchandise <<category>>
rectangle "6. Delivery Features\n(Giao hàng)" as delivery <<category>>

client --> auth
client --> profile
client --> customer
client --> cashier
client --> merchandise
client --> delivery

' Auth children
rectangle "Đăng nhập\n(Login)" as login
rectangle "Đăng ký\n(Sign Up)" as signup
rectangle "Quên mật khẩu\n(Forgot Password)" as forgot
auth --> login
auth --> signup
auth --> forgot

' Profile children
rectangle "Cập nhật thông tin\n(Update Info)" as update_info
rectangle "Điểm tích lũy\n(Member Points)" as member_points
profile --> update_info
profile --> member_points

' Customer children
rectangle "Tìm kiếm & Duyệt\n(Browse/Search)" as cust_search
rectangle "Giỏ hàng trực tuyến\n(Online Cart)" as cust_cart
rectangle "Thanh toán\n(Checkout)" as cust_checkout
rectangle "Theo dõi đơn hàng\n(Order Tracking)" as cust_track
rectangle "Đánh giá sản phẩm\n(Feedback)" as cust_review
customer --> cust_search
customer --> cust_cart
customer --> cust_checkout
customer --> cust_track
customer --> cust_review

' Cashier children
rectangle "Giao dịch POS\n(POS Sale)" as cash_pos
rectangle "Áp dụng khuyến mãi\n(Apply Promo)" as cash_promo
rectangle "Tích/Tiêu điểm\n(Points Mgt)" as cash_points
rectangle "Xuất hóa đơn\n(Invoice Receipt)" as cash_invoice
cashier --> cash_pos
cashier --> cash_promo
cashier --> cash_points
cashier --> cash_invoice

' Merchandise children
rectangle "Sơ đồ kệ hàng\n(Shelf Layout)" as merch_layout
rectangle "Xếp hàng lên kệ\n(Product to Shelf)" as merch_shelf
rectangle "Báo cáo hàng hỏng\n(Damaged Report)" as merch_report
rectangle "Xem chỉ dẫn\n(Instructions)" as merch_inst
merchandise --> merch_layout
merchandise --> merch_shelf
merchandise --> merch_report
merchandise --> merch_inst

' Delivery children
rectangle "Tiếp nhận đơn giao\n(Accept Deliveries)" as del_accept
rectangle "Cập nhật trạng thái\n(Update Status)" as del_status
rectangle "Lịch sử giao hàng\n(Delivery History)" as del_history
delivery --> del_accept
delivery --> del_status
delivery --> del_history

@enduml
