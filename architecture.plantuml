@startuml system_architecture
skinparam shadowing false
skinparam roundcorner 6
skinparam arrow {
    Color #2C3E50
    Thickness 1.5
    FontColor #2C3E50
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #B3B7BD
    FontColor #2C3E50
    FontSize 12
    FontStyle bold
}

skinparam actor {
    BackgroundColor #F8F9FA
    BorderColor #2C3E50
    FontColor #2C3E50
    FontSize 12
    FontStyle bold
}

' Define elements
actor "Users & Roles\n- Manager\n- Cashier\n- Warehouse Staff\n- Delivery Staff\n- Customer" as user

rectangle "Frontend - React.js (Vite)\n(Client Side)" as frontend #EBF5FB {
    rectangle "Web Browser\n(SPA Single Page App)" as ui_web
    rectangle "UI/UX Components\n(Views, Pages & Forms)" as ui_comp
    rectangle "State Management\n(Custom Hooks & Context)" as ui_state
    rectangle "API Services\n(Axios Client)" as ui_api
    
    ui_web --> ui_comp
    ui_comp --> ui_state
    ui_state --> ui_api
}

rectangle "Backend - Express.js (Node.js)\n(RESTful API Application Server)" as backend #FEF9E7 {
    rectangle "Routes & Endpoints\n(Router Layer)" as be_routes
    rectangle "Middlewares\n(JWT Auth, Rate Limit, Validator)" as be_middleware
    rectangle "Controllers\n(Request/Response Handler)" as be_controllers
    rectangle "Services & Repositories\n(Business Logic & Concurrency)" as be_services
    
    be_routes --> be_middleware
    be_middleware --> be_controllers
    be_controllers --> be_services
}

rectangle "Database - MongoDB (Mongoose)\n(Data Storage Tier)" as db #E8F8F5 {
    rectangle "Accounts & Profiles\n(Account, Staff, Customer, Manager)" as db_auth
    rectangle "Inventory & Shelves\n(Product, Shelf, Section, Stock, Batch)" as db_inv
    rectangle "Transactions & Carts\n(Order, OrderItem, Cart, CartItem)" as db_orders
    rectangle "Invoices & Payments\n(Invoice, Payment, DeliveryOrder)" as db_billing
    rectangle "Business Utilities\n(Supplier, Promotion, Report, Feedback)" as db_util
}

' External services
rectangle "Cloudinary\n(Image Hosting)" as ext_cloud #EBF5FB
rectangle "Redis / RAM Cache\n(Query Cache)" as ext_redis #FDEDEC

' Connect elements
user --> ui_web : Interacts / Browse Website

ui_api --> be_routes : API Requests (HTTP/JSON)
be_routes ..> ui_api : API Responses (HTTP/JSON)

be_services --> db_auth : Queries / Updates
be_services --> db_inv : Queries / Updates
be_services --> db_orders : Queries / Updates
be_services --> db_billing : Queries / Updates
be_services --> db_util : Queries / Updates

be_services --> ext_cloud : Upload / Retrieve Images
be_services --> ext_redis : Cache Query / Session Data

@enduml
