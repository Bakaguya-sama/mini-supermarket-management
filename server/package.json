{
  "name": "mini-supermarket-server",
  "version": "1.0.0",
  "description": "Backend API for Mini Supermarket Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore generated-openapi/ --ignore generated-tests/ --ignore openapi.yaml --ignore .openapi-task-state.json server.js",
    "seed": "node scripts/seed.js",
    "seed:clear": "node scripts/seed.js --clear",
    "backfill:expiry": "node scripts/backfill-expiry-dates.js",
    "migrate:batches": "node scripts/convert-stocks-to-batches.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --verbose",
    "generate:all-controller-tests": "node test-generator/all/index.js",
    "test:all-controller-generated": "cross-env NODE_ENV=test jest --runInBand --verbose test-generator/generated-tests-all",
    "generate:openapi": "node swaggerDef.js",
    "generate:openapi-tests": "node test-generator/index.js",
    "test:openapi-generated": "cross-env NODE_ENV=test jest --runInBand --verbose --json --outputFile=generated-tests/openapi-results.json --silent generated-tests/openapi-generated"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "setupFiles": [
      "<rootDir>/tests/jestSetup.js"
    ],
    "reporters": [
      "default",
      "<rootDir>/test-generator/jestResultsReporter.js"
    ]
  },
  "keywords": [
    "supermarket",
    "mongodb",
    "express",
    "nodejs"
  ],
  "author": "Your Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.47.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/resources": "^1.25.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "@opentelemetry/sdk-trace-base": "^1.25.0",
    "@opentelemetry/sdk-trace-node": "^1.25.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "amqplib": "^2.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "express-status-monitor": "^1.3.4",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "js-yaml": "^4.1.1",
    "swagger-jsdoc": "^6.2.8"
  }
}
